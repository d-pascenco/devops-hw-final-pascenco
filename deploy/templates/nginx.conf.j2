{{ ansible_managed | comment }}

server {
    listen {{ nginx__port }};

    # резолвим контейнер через DNS докера с ttl 10s, чтобы после пересоздания сервиса не было 502
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $audit_svc http://{{ audit_svc__container }}:8080;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # наружу открыты только /api/, /healthz и /metrics (nginx сам нормализует // и %XX до проверки location)
    location /api/ {
        proxy_pass $audit_svc;
    }
    location = /healthz {
        proxy_pass $audit_svc;
    }
    location = /metrics {
        proxy_pass $audit_svc;
    }

    # /reload только для внутренних запросов (снаружи закрыт)
    location ^~ /reload {
        return 404;
    }
    # остальные пути закрыты
    location / {
        return 404;
    }
}

# stub_status для nginx-exporter: отдельный порт, наружу не публикуется
server {
    listen {{ nginx__status_port }};
    location = /stub_status {
        stub_status;
    }
    location / {
        return 404;
    }
}
